{
  "name": "sluice",
  "private": true,
  "version": "0.1.0",
  "description": "Sluice: an autonomous cross-chain yield agent on NEAR Intents. The agent proposes, the policy gate decides, capital flows.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dry": "tsx src/dry-run.ts --fixtures",
    "dry:live": "tsx src/dry-run.ts --live",
    "dry:fixtures": "tsx src/dry-run.ts --fixtures",
    "record-fixtures": "tsx src/dry-run.ts --live --record",
    "test": "node --import tsx --test src/*.test.ts",
    "attack": "tsx scripts/attack.ts",
    "execute": "tsx src/execute.ts",
    "control": "tsx src/serve.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "gate:test": "cargo test --manifest-path contracts/sluice-gate/Cargo.toml",
    "gate:build": "cargo build --manifest-path contracts/sluice-gate/Cargo.toml --target wasm32-unknown-unknown --release",
    "gate:sandbox": "cargo test --manifest-path contracts/sluice-gate/Cargo.toml --features sandbox --test sandbox -- --nocapture"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
