# Copy to .env. Never commit .env.
# Dry-run needs none of these. A live dry quote (still no funds moved) needs the two addresses.

# NEAR AI Cloud. https://cloud.near.ai — OpenAI-compatible gateway.
# Without this key the brain stays on the deterministic rules proposal.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.2
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# 1Click partner JWT, sent as X-API-Key. Optional.
# Docs: without a key, non-ANY_INPUT quotes add 25 bps. With a key, stablecoin
# routes are 1 bp. https://docs.near-intents.org/resources/fees.md
ONECLICK_API_KEY=
ONECLICK_BASE_URL=https://1click.chaindefuser.com

# Destination address for a dry or live quote. For USDC on NEAR this is a NEAR account.
# Refund address on the origin chain. For USDC on Base this is an 0x address.
# Dry quotes do not create a deposit address and do not move funds.
SLUICE_RECIPIENT=
SLUICE_REFUND_TO=

# On-chain gate. Empty in this repo until you deploy.
SLUICE_GATE_CONTRACT=
SLUICE_GATE_NETWORK=testnet
# Account that holds the function-call key. The keychain stays outside the repo.
SLUICE_NEAR_ACCOUNT_ID=
# Chain Signatures path for Base. Distinct from an Ethereum path.
SLUICE_DERIVATION_PATH=base-1
# Explicit Base address. If you also derive one, they must be the address you intend to fund.
SLUICE_BASE_ADDRESS=
# A second account that can attach 1 yoctoNEAR to v1.signer.sign.
# A function-call key cannot. Leave this empty until you approve a live move.
SLUICE_SIGNER_ACCOUNT=
SLUICE_BASE_RPC=

# Live execution needs all three, and you still have to mean it.
# npm run execute -- --live
# LIVE=1
# SLUICE_EXECUTE=yes
